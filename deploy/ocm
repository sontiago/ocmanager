#!/usr/bin/env bash
# Команда ocm: находит каталог установки (скрипт может быть ссылкой в /usr/local/bin)
# и передаёт управление Python-части.
set -euo pipefail

self="$(readlink -f "${BASH_SOURCE[0]}")"
root="$(dirname "$(dirname "$self")")"

if [ "$(id -u)" -ne 0 ]; then
  echo "ocm нужно запускать от root: sudo ocm $*" >&2
  exit 1
fi

# Мы root и импортируем код из каталога установки: он не должен быть доступен на запись другим.
# Всё, что root исполняет или читает как код, и все каталоги над клоном.
bad="$(find "$root" "$root/deploy" "$root/scripts" -maxdepth 0 -perm /022
  find "$root/deploy/installer" "$root/deploy/ocm" "$root/deploy/docker-compose.yml" \
    "$root/scripts" ! -type l -perm /022
  dir="$(dirname "$root")"
  while [ "$dir" != "/" ]; do find "$dir" -maxdepth 0 -perm /022; dir="$(dirname "$dir")"; done)"
if [ -n "$bad" ]; then
  echo "Небезопасные права (запись для группы или всех) — исправьте (chmod go-w):" >&2
  echo "$bad" >&2
  exit 1
fi

# -I: интерпретатор не берёт модули из текущего каталога и из PYTHONPATH.
exec python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from installer.ocm import main; sys.exit(main(sys.argv[2:]))' "$root/deploy" "$@"
