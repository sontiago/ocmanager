# Dev-настройки бэкенда: cp .env.example .env
# Значения совпадают с deploy/docker-compose.dev.yml (make dev-up).
# Тесты этот файл не читают — см. conftest.py.

# dev | test | production
OCM_ENV=dev
OCM_DATABASE_URL=postgresql+asyncpg://ocm:ocm@127.0.0.1:54320/ocmanager
OCM_REDIS_URL=redis://127.0.0.1:63790/0
# ≥ 32 символов. В production: python -c "import secrets; print(secrets.token_urlsafe(48))"
OCM_SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
OCM_LOG_LEVEL=INFO
# json — для production и сбора логов, console — читать глазами
OCM_LOG_FORMAT=console
